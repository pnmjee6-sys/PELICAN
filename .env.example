# ==============================================================================
# Context Passport V3 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.
#
# NOTE: In test mode or local mock runs, you do not need real OpenRouter keys:
# export APP_ENV=test ALLOW_TEST_AUTH=true ALLOW_OFFLINE_EMBEDDINGS=true

# ------------------------------------------------------------------------------
# 1. Model Provider Routing (OpenRouter Primary + Fallback)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_PRIMARY_MODEL=z-ai/glm-5.3-flash
EXTRACTION_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Embeddings (1536-dimensional text-embedding-3-small via OpenRouter)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# Jev validation through OpenRouter — uses the same OPENROUTER_API_KEY
ENABLE_JEV_VALIDATION=false
JEV_MODEL=typesafe/jev-router

# Reliability & Spending Limits
OPENROUTER_SPENDING_CAP=2.00
JEV_SPENDING_CAP=1.00
JEV_MAX_CALLS=20
PROVIDER_TIMEOUT_SECONDS=30.0
PROVIDER_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas (Stores vector memories and application control collections)
# ------------------------------------------------------------------------------
# Requires an Atlas Vector Search index named 'memories_vector_index_scoped'
# on the 'memories' collection with:
#   - dimensions: 1536
#   - similarity: cosine
#   - filter field: payload.user_id
MONGODB_URI=
MONGODB_DB_NAME=context_passport
MONGODB_COLLECTION_NAME=memories
MONGODB_VECTOR_INDEX_NAME=memories_vector_index_scoped

# ------------------------------------------------------------------------------
# 3. Supabase Auth (User identity & JWT token issuance only)
# ------------------------------------------------------------------------------
# Used strictly for user sign-in and verifying JWT claims.
# No dual-database sync; identity is derived solely from verified tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Runtime & Storage Isolation
# ------------------------------------------------------------------------------
# Local default. Render sets HOST=0.0.0.0 with PUBLIC_HOSTING=true explicitly.
HOST=127.0.0.1
PORT=8000
PUBLIC_HOSTING=false
MEM0_HISTORY_DB_PATH=backend/mem0_history.db

# ------------------------------------------------------------------------------
# 5. Legacy Reference Models (For backward compatibility / migration tools)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMS=1536
