# Context Passport — V1 backend environment
#
# Copy the values into the already-gitignored .env file. Never commit .env.
# Use a paid Gemini API project for personal data. Do not expose any value below
# to the browser extension, source control, logs, or client-side builds.

# Required for real V1 extraction and 1536-dimensional embeddings.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMS=1536
# Set to true only after checking billing for this API key's Google project.
GEMINI_PAID_TIER_CONFIRMED=false
MEM0_TELEMETRY=false

# Required MongoDB Atlas application database and vector index.
MONGODB_URI=
MONGODB_DB_NAME=context_passport
MONGODB_COLLECTION_NAME=memories
MONGODB_VECTOR_INDEX_NAME=memories_vector_index_scoped

# Required Supabase Auth configuration. Keep the service-role key server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server settings.
HOST=0.0.0.0
PORT=8000
BUILD_MARKER=context-passport-v1-api-001
MEM0_HISTORY_DB_PATH=backend/mem0_history.db
